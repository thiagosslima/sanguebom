# Copie para .env e ajuste os valores. O arquivo .env nao vai para o git.
# Usado pelo docker-compose.yml e pela aplicacao rodando localmente.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sanguebom
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Parametros extras da URL JDBC. Vazio em local; em provedores gerenciados
# que exigem TLS (ex.: Neon) use: DB_PARAMS=?sslmode=require
DB_PARAMS=
